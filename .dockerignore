# Docker build context exclusions for the reproducible test/build image.
# Mirrors .gitignore, plus things that are fine to keep in git but have no
# business inside a container image (VCS metadata, local dev artifacts,
# personal/export data, host-only packaging scripts).

# Version control / CI meta
.git/
**/.git/
**/.gitattributes
.github/
.gitignore
.dockerignore

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
/dist/
/build/

# Node / Vite
desktop/node_modules/
desktop/dist/
desktop/.vite/

# Rust / Tauri build output (kept: runtime/.gitkeep, needed by cargo check —
# see the Dockerfile's own explicit mkdir/touch fallback for the case where
# a build context doesn't have it)
desktop/src-tauri/target/
desktop/src-tauri/runtime/*
!desktop/src-tauri/runtime/.gitkeep

# Local runtime / user data — must never reach an image
logs/
desktop/logs/
*.db
*.db-shm
*.db-wal
*.log
config.json
desktop/config.json

# Host-only packaging & installer tooling (PowerShell, Windows-only)
packaging/*.ps1
packaging/cache/
*.msi
*.exe
*.zip
*.7z

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.cursor/
.claude/

# Misc large/unrelated tracked assets not needed for test or build
*.png
*.jpg
*.jpeg
!desktop/public/**
!desktop/src-tauri/icons/**

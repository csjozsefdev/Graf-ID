<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration for Graf-Id.

  This file is not read by the build: paste it into the SignPath project
  (Project > Artifact configuration) so SignPath knows what the release workflow
  uploads. The workflow uploads a ZIP with the two installers at its root; both
  are Authenticode-signed. The product name is enforced so that only Graf-Id
  installers can be signed with this project.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="Graf-Id_*_x64-setup.exe" product-name="Graf-Id">
      <authenticode-sign/>
    </pe-file>
    <msi-file path="Graf-Id_*_x64_en-US.msi">
      <authenticode-sign/>
    </msi-file>
  </zip-file>
</artifact-configuration>
